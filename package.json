{
  "name": "tradepulse-precision15",
  "version": "0.1.0",
  "private": true,
  "description": "Selective 15-minute NIFTY and SENSEX options signal assistant with approval-gated Kite execution.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "telegram:setup": "tsx scripts/telegram-setup.ts",
    "telegram:test": "tsx scripts/telegram-test.ts",
    "kite:login": "tsx scripts/kite-auth.ts",
    "kite:token": "tsx scripts/kite-auth.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
