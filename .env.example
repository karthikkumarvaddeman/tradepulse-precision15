# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=3100
APP_TIMEZONE=Asia/Kolkata

# Trading profile: set your actual deployable trading capital before enabling actionable signals.
TRADING_CAPITAL_INR=0
MAX_CAPITAL_INR=100000
RISK_PER_TRADE_PERCENT=0.5
MAX_DAILY_LOSS_PERCENT=1.5
MAX_TRADES_PER_DAY=2
MAX_OPEN_RECOMMENDATIONS=1
MIN_SIGNAL_SCORE=85

# Safe defaults. Live order placement must remain disabled until all broker/regulatory checks pass.
TRADING_MODE=PAPER
LIVE_ORDER_PLACEMENT_ENABLED=false
KITE_STATIC_IP_CONFIRMED=false
LIVE_ORDER_CONFIRMATION_PHRASE=

# Kite Connect credentials (never commit real values)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=http://127.0.0.1:3100/auth/kite/callback

# Telegram notifications (optional; private chat recommended)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local app protection
APP_LOCAL_ACCESS_TOKEN=change-this-to-a-long-random-value
